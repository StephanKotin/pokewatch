PORT=3000
POKETRACE_API_KEY=your_key_here
# Required — the server refuses to start without it. Generate one with:
# openssl rand -hex 32
JWT_SECRET=
# Optional. Free fallback price source used when PokeTrace has no data for a
# card. Works without a key (1,000 req/day, 30/min); sign up at
# https://pokemontcg.io/ for 20,000 req/day.
POKEMONTCGIO_API_KEY=
# Required to notify anyone of new signups. Free account at
# https://resend.com — no domain verification needed to start (emails send
# from onboarding@resend.dev until you verify your own domain).
RESEND_API_KEY=
# Where new-account approval requests get sent. Without this, registrations
# are accepted into a pending state but nobody is notified to approve them.
ADMIN_EMAIL=
# Optional. Sender shown on outgoing emails; defaults to Resend's shared
# sandbox address, which works fine until you verify your own domain.
EMAIL_FROM=
# The public URL the COLLECTOR TOOL is reachable at — used to build the
# approve/reject links in registration emails and the "sign in here" /
# "return to PokeWatch" links. Defaults to http://localhost:$PORT for local
# dev; set this to your real host in production. No trailing slash (one is
# stripped anyway, but don't rely on that).
APP_BASE_URL=
# The public URL the STORE is reachable at (e.g. https://tcgoftexas.com).
# Used only for Stripe's success_url and cancel_url, so a buyer who finishes
# paying returns to the site they were actually shopping on. Also added to the
# CORS origin list alongside APP_BASE_URL.
#
# One process serves both products, so these are two values, not one. Leave
# this unset and it falls back to APP_BASE_URL, which is exactly the old
# single-URL behaviour — nothing breaks, but if the two products are on
# different hosts then one of them has wrong links until this is set.
STORE_BASE_URL=
# Optional. Path to the SQLite file. Point this at a mounted persistent
# volume on hosts with an ephemeral filesystem (e.g. Railway) so data
# survives redeploys. Defaults to ./pokewatch.db.
DB_PATH=
# Optional. PostHog analytics — client-side, baked into the build at
# `vite build` time (not read at server runtime like the vars above), so it
# must be set wherever the build actually happens. Left unset in local dev
# on purpose so local testing doesn't pollute real analytics; only set this
# in production. Project API Key is a public/client-side key, safe to
# commit to a build — it's not a secret like the vars above.
VITE_POSTHOG_KEY=
# Optional. Defaults to PostHog's US Cloud host if unset.
VITE_POSTHOG_HOST=
# Required for the store to accept payments. Without it, checkout returns a
# 503 instead of creating a Stripe session.
#
# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...). This process
# only needs write access to Checkout Sessions, so a restricted key scoped to
# that does far less damage if it leaks. Create one at
# https://dashboard.stripe.com/apikeys ("Create restricted key").
#
# For a test key with no signup at all: `npm i -g @stripe/cli` then
# `stripe sandbox create`. A sandbox is an isolated Stripe test environment;
# prefer a dedicated sandbox over the shared test mode for new development.
STRIPE_SECRET_KEY=
# Required for order fulfillment (marking orders paid, decrementing stock,
# sending confirmation emails) to run at all — fulfillment is driven from the
# webhook, never the success page, because a customer can pay and then close
# the tab before it loads.
#
# Locally: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# and use the whsec_ it prints. In production: add an endpoint for
# https://tcgoftexas.com/api/webhooks/stripe in the Stripe Dashboard
# (Developers > Webhooks) — it issues a DIFFERENT secret than `stripe listen`.
# Subscribe it to: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=
# Optional. Stripe product tax code applied to every store line item.
# Defaults to txcd_99999999 ("General - Tangible Goods"). Browse the real
# list at https://docs.stripe.com/tax/tax-codes and have a tax advisor
# confirm the right code for collectible trading cards before going live.
#
# WARNING: automatic_tax is enabled in server.js, but Stripe Tax only
# collects where you hold an ACTIVE registration. With no registration it
# does NOT error — it silently collects $0 while checkout looks correct, and
# that cannot be corrected retroactively. Add your registration under
# Dashboard > Tax > Locations (live mode; sandbox registrations don't carry
# over) BEFORE taking real orders.
STRIPE_PRODUCT_TAX_CODE=
# Where the daily company report gets emailed. A Claude Code cloud routine
# commits business/daily/<YYYY-MM-DD>.md to the `reports` branch (not master,
# which would redeploy production just to ship a markdown file) at 12:00 UTC
# on weekdays; this process fetches that ref read-only at 13:00 UTC and mails
# the file. Unset means the job logs once and returns — nothing else breaks.
# Needs RESEND_API_KEY set too, since it goes out through the same sender.
REPORT_EMAIL_TO=
