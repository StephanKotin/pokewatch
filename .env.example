PORT=3000
POKETRACE_API_KEY=your_key_here
# Required for stable logins. Without this, the server generates a random
# secret on every restart, invalidating every user's session. Generate one
# with: openssl rand -hex 32
JWT_SECRET=
# Optional. Free fallback price source used when PokeTrace has no data for a
# card. Works without a key (1,000 req/day, 30/min); sign up at
# https://pokemontcg.io/ for 20,000 req/day.
POKEMONTCGIO_API_KEY=
# Required to notify anyone of new signups. Free account at
# https://resend.com — no domain verification needed to start (emails send
# from onboarding@resend.dev until you verify your own domain).
RESEND_API_KEY=
# Where new-account approval requests get sent. Without this, registrations
# are accepted into a pending state but nobody is notified to approve them.
ADMIN_EMAIL=
# Optional. Sender shown on outgoing emails; defaults to Resend's shared
# sandbox address, which works fine until you verify your own domain.
EMAIL_FROM=
# The public URL this app is reachable at — used to build the approve/reject
# links in emails and the "return to app" link. Defaults to
# http://localhost:$PORT for local dev; set this to your real host in
# production (e.g. https://pokewatch.up.railway.app).
APP_BASE_URL=
# Optional. Path to the SQLite file. Point this at a mounted persistent
# volume on hosts with an ephemeral filesystem (e.g. Railway) so data
# survives redeploys. Defaults to ./pokewatch.db.
DB_PATH=
