node_modules/
.env
# Any .env variant (.env.local, .env.bak-*, .env.save from a nano crash) is a
# plaintext secrets file. `git reset --hard` never removes untracked files, so
# one left on the droplet lingers forever. .env.example is the deliberate
# exception and stays tracked.
.env.*
!.env.example
*.db
.DS_Store
Thumbs.db
# Claude Code config. The shared agent architecture (agents/, the hand-written
# skills/, and the reviewed permission allowlist) IS committed — it's the
# project's own tooling and a fresh clone should get it. settings.local.json is
# NOT: it's machine-local, accumulates per-approval entries, and those entries
# can embed live API keys.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/settings.json
# Defensive only: this project installs skills scoped to claude-code, which
# writes real files into .claude/skills/ and never creates .agents/. An
# UNSCOPED `npx skills add <src> --all` would create .agents/ plus ~49 other
# per-tool directories; this keeps the stray copy out of a commit if that
# happens. See .claude/agents/README.md for the correct install command.
.agents/
dist/
playwright-report/
test-results/
